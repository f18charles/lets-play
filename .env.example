# Copy to .env, fill in, then load with:  set -a; source .env; set +a
# Never commit .env

# MongoDB: local or Atlas. Put the database name before the "?". Keep the single quotes.
MONGODB_URI='mongodb://localhost:27017/letsplay'
# MONGODB_URI='mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/letsplay?retryWrites=true&w=majority&appName=Cluster0'

# Optional: separate database for tests. Tests wipe it, so never use the real database name.
# MONGODB_URI_TEST='mongodb://localhost:27017/letsplay_test'

# Required. At least 32 bytes. Make one with:  openssl rand -hex 32
JWT_SECRET=

# Optional. Seeds one admin at startup. Password needs 8+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# HTTPS keystore password (the one you chose when making keystore.p12)
SSL_KEYSTORE_PASSWORD=
# SSL_KEYSTORE=file:./keystore.p12

# Websites allowed to call the API from a browser, comma-separated
CORS_ORIGINS=https://localhost:3000